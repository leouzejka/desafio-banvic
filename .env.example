# Copie para .env e preencha os valores: cp .env.example .env
# O .env não é versionado (está no .gitignore).

# PostgreSQL (Docker Compose). O mesmo usuário é usado pelo Airflow e pelo Meltano.
POSTGRES_DB=banvic_database
POSTGRES_USER=banvic
POSTGRES_PASSWORD=banvic_
POSTGRES_PORT=5432

# Endereço do PostgreSQL visto de dentro do Minikube.
# host.minikube.internal alcança a porta publicada pelo Compose na máquina local.
POSTGRES_HOST=host.minikube.internal

# Chave compartilhada pela Execution API do Airflow 3.
# Gere com: openssl rand -hex 32
AIRFLOW_JWT_SECRET=replace_with_a_random_value
